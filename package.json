    "@clack/prompts": "^0.7.0",
    "axios": "^1.6.0",
    "chalk": "^5.3.0",
    "chalk-animation": "^2.0.3",
    "gradient-string": "^3.0.0",
    "ssh2": "^1.15.0",
    "tweetsodium": "^0.0.4"
  },
  "devDependencies": {
    "@types/chalk-animation": "^1.6.3",
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^20.10.0",
    "@types/ssh2": "^1.11.18",
    "tsx": "^4.6.0",
    "typescript": "^5.3.2"
  }
}
